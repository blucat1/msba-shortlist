# Browser-safe build configuration. Demo works without this file.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_BROWSER_SAFE_PUBLISHABLE_KEY
VITE_SITE_URL=http://localhost:5173
VITE_OWNER_CONTACT=

# Server only. Never prefix these with VITE_, commit real values, or configure them in the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET
# Edge function only; exact production origin.
ALLOWED_ORIGINS=https://YOUR_PROJECT.pages.dev
